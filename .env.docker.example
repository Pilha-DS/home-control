# Copie para .env na raiz do projeto:  cp .env.docker.example .env
# Depois: docker compose up -d --build

# --- Porta exposta do app (nginx + Flutter web) ---
APP_PORT=8080

# --- MySQL ---
MYSQL_ROOT_PASSWORD=home_root_secret
MYSQL_DATABASE=home_control
MYSQL_USER=home
MYSQL_PASSWORD=home_secret

# --- Backend / JWT ---
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Segurança / CORS / rate limit (opcional) ---
# Em produção restrinja o CORS, desligue o Swagger e exija segredos fortes:
# CORS_ALLOWED_ORIGINS=https://automacao.omny.app.br
# SPRINGDOC_ENABLED=false
# APP_STRICT_SECRETS=true
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_WINDOW_SECONDS=60

# Transporte: java = ESP fala HTTP direto com o backend (padrao, sem Mosquitto)
APP_TRANSPORT=java

# --- MQTT legado (so se APP_TRANSPORT=mqtt) ---
MQTT_HOST=mosquito.omny.tec.br
MQTT_PORT=443
MQTT_USER=cardoso
MQTT_PASS=C6m8n4d2d3
MQTT_PATH=/
MQTT_SSL=true

# Para Mosquitto local (profile "local-mqtt"), use TCP sem path:
# MQTT_HOST=mosquitto
# MQTT_PORT=1883
# MQTT_USER=backend
# MQTT_PASS=backend_secret
# MQTT_PATH=
# MQTT_SSL=false

# URI completa sobrescreve host/port/ssl/path (ex.: wss://mosquito.omny.tec.br:443/)
# MQTT_URL=
